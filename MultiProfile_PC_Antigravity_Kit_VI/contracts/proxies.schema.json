{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalized proxy metadata v1, no plaintext secrets",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "scheme": {
        "type": "string",
        "enum": [
          "http",
          "https",
          "socks5"
        ]
      },
      "host": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[^\\s/@]+$"
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "auth_kind": {
        "type": "string",
        "enum": [
          "none",
          "basic",
          "username_password"
        ]
      },
      "secret_ref": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 256
      },
      "config_revision": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "id",
      "label",
      "scheme",
      "host",
      "port",
      "auth_kind",
      "secret_ref",
      "config_revision"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "auth_kind": {
              "const": "none"
            }
          }
        },
        "then": {
          "properties": {
            "secret_ref": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "secret_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "scheme": {
              "const": "socks5"
            }
          }
        },
        "then": {
          "properties": {
            "auth_kind": {
              "enum": [
                "none",
                "username_password"
              ]
            }
          }
        },
        "else": {
          "properties": {
            "auth_kind": {
              "enum": [
                "none",
                "basic"
              ]
            }
          }
        }
      }
    ]
  },
  "minItems": 1,
  "maxItems": 5000
}
