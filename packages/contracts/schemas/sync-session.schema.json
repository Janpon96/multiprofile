{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sync session metadata v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ARMING",
        "RUNNING",
        "PAUSED",
        "STOPPING",
        "STOPPED"
      ]
    },
    "master_profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "follower_profile_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1,
      "maxItems": 49,
      "uniqueItems": true
    },
    "logical_tab_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "mode": {
      "type": "string",
      "enum": [
        "dom",
        "coordinate"
      ]
    },
    "failure_policy": {
      "type": "string",
      "enum": [
        "strict",
        "continueHealthy"
      ]
    },
    "allowed_origins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://",
        "maxLength": 2048
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "queue_capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "queue_max_age_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000
    },
    "fixed_stagger_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "config_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "epoch",
    "state",
    "master_profile_id",
    "follower_profile_ids",
    "logical_tab_id",
    "mode",
    "failure_policy",
    "allowed_origins",
    "queue_capacity",
    "queue_max_age_ms",
    "fixed_stagger_ms",
    "config_revision"
  ],
  "additionalProperties": false
}
