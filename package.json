{
  "name": "multiprofile-studio",
  "version": "1.0.0",
  "private": true,
  "description": "MultiProfile Studio PC — Multi-profile Chromium manager and synchronization tool",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @multiprofile/contracts -w @multiprofile/domain -w @multiprofile/browser -w @multiprofile/platform-windows -w @multiprofile/proxy -w @multiprofile/storage -w @multiprofile/sync -w @multiprofile/worker -w @multiprofile/desktop",
    "engine:install:pinned": "node scripts/engine-install.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "npm --workspace=@multiprofile/desktop run dev",
    "lint": "npm run typecheck",
    "typecheck": "npm run build",
    "test:unit": "vitest run tests/unit packages",
    "test:integration": "vitest run tests/integration",
    "test:e2e:windows": "vitest run tests/e2e/windows",
    "test:e2e:lifecycle": "vitest run tests/e2e/lifecycle",
    "test:e2e:electron": "vitest run tests/e2e/electron",
    "test:proxy-matrix": "vitest run tests/proxy-matrix",
    "test:sync-matrix": "vitest run tests/sync-matrix",
    "bench": "node scripts/bench.mjs",
    "package:win": "npm run build && node scripts/verify-release.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.8.1",
    "electron": "45.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "playwright-core": "^1.64.1",
    "proxy-chain": "^3.0.1"
  }
}
